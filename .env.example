# Copie pra .env e preencha. NUNCA commite o .env.

# Connection string da Supabase (use o "Connection Pooler" — porta 6543)
# Settings → Database → Connection string → URI (Mode: Transaction)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Segredo do JWT (gere com: openssl rand -hex 32)
JWT_SECRET=troque-isso-por-uma-string-aleatoria-bem-grande

# Login do admin
ADMIN_USER=lafefa
ADMIN_PASS=adminlafe

# Porta local
PORT=3000
